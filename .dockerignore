# Secrets — ne jamais inclure dans l'image
.env

# Bases de données locales
*.db
database/

# Cache Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Environnement virtuel
venv/
.venv/

# Git
.git/
.gitignore

# Logs
*.log
*.error

# Les réponses seedées (src/oceens/seed_data/seed_answers*.csv) entrent dans
# l'image : sur App Service, aucun volume ne les monte, et sans elles les
# sondages seedés n'ont rien à synthétiser.
